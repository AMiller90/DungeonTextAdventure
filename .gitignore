# ============================================
# Merchant Adventure - Unity .gitignore
# ============================================

# -------------------------
# Unity generated folders
# -------------------------

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures generated by Unity
[Mm]emoryCaptures/

# Asset import worker cache
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin


# -------------------------
# Unity crash reports
# -------------------------

sysinfo.txt


# -------------------------
# Visual Studio / Rider
# -------------------------

.vs/
.idea/
.vscode/

# Rider project files
*.sln.iml

# Visual Studio cache/options
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Visual Studio Code
.vscode/


# -------------------------
# Generated project files
# -------------------------

*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd

# Unity generated solution files
ExportedObj/
.consulo/


# -------------------------
# OS files
# -------------------------

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Finder
Icon

# Windows installer files
*.cab
*.msi
*.msix
*.msm
*.msp


# -------------------------
# Build artifacts
# -------------------------

*.apk
*.aab
*.unitypackage
*.app
*.exe
*.appimage
*.dmg

# WebGL
Build/
build/


# -------------------------
# Addressables
# -------------------------

/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin


# -------------------------
# Plastic SCM
# -------------------------

.plastic/
plastic4/
*.plastic


# -------------------------
# JetBrains
# -------------------------

.idea/
*.sln.iml


# -------------------------
# Generated documentation
# -------------------------

/[Dd]ocs/[Gg]enerated/


# -------------------------
# Temporary / backup files
# -------------------------

*.bak
*.backup
*.orig
*.swp
*.swo
*~
*.pid
*.pidb
*.pdb


# -------------------------
# Secrets / local config
# -------------------------

.env
.env.*
!.env.example

# Local development configuration
*.local

# Never commit private keys
*.pem
*.key
*.p12
*.pfx


# -------------------------
# Test / coverage output
# -------------------------

/[Cc]overage/
/[Tt]est[Rr]esults/
*.coverage
*.coveragexml


# -------------------------
# IDE metadata
# -------------------------

# Visual Studio Code workspace settings
.vscode/

# Local Rider/IDE settings
.idea/


# -------------------------
# Unity user-specific data
# -------------------------

UserSettings/


# -------------------------
# Optional local folders
# -------------------------

/_Local/
/LocalBuilds/
/LocalData/
